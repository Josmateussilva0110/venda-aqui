NODE_ENV=development
PORT=3333

# Supabase: Project Settings > API. A chave secreta (service_role / sb_secret_...) fica só no servidor.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=

# Segredo para assinar o access token (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=

# Origens web liberadas no CORS, separadas por vírgula. Apps nativos (sem Origin) passam sempre.
CORS_ORIGINS=http://localhost:8081

# Envio do código de recuperação de PIN: "console" (só desenvolvimento) ou "meta" (WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
